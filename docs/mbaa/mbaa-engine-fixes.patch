diff --git a/test/test-app-files-policy.js b/test/test-app-files-policy.js
index 565d31cb6..f11924aa6 100644
--- a/test/test-app-files-policy.js
+++ b/test/test-app-files-policy.js
@@ -81,9 +81,113 @@ for (const f of out) {
   assert(['required', 'lazy', 'background'].includes(f.loadMode));
 }
 
+// ---- preloadAssets: "all the textures must be in before the player plays" --
+//
+// MBAACC's sprite (0002.p, ~900MB) and stage (0003.p, ~140MB) archives are two
+// orders of magnitude over APP_EAGER_BYTES, so the policy above streams them
+// and every miss inside a battle is a Loading window -- and, when a fill fails,
+// a read the game caches as NULL forever. `preloadAssets` names the files that
+// must be IN before the first frame. The two shapes are distinct on purpose:
+// a whole archive is `required` (launch progress, launch failure), a measured
+// subset is `lazy` + `preloadRanges` (those bytes at launch, the rest still
+// streaming).
+const archives = (size) => [
+  { url: 'binaries/mbaa/0002.p', vfsPath: 'c:\\0002.p', size },
+  { url: 'binaries/mbaa/0003.p', vfsPath: 'c:\\0003.p', size },
+  { url: 'binaries/mbaa/0005.p', vfsPath: 'c:\\0005.p', size },
+];
+const BIG = 900 * MB;
+{
+  // Nothing declared: the current behaviour, and the control arm.
+  const base = normalizeLazyFiles({}, archives(BIG));
+  assert.strictEqual(base.summary.policy, 'lazy');
+  assert(base.files.every(f => f.httpRange === true && f.loadMode === undefined),
+    'without preloadAssets every archive streams');
+
+  // A required archive by guest path, by URL and by leaf all work: the author
+  // names the file, not the VFS's flattened spelling.
+  for (const name of ['0002.p', 'c:\\0002.p', 'binaries/mbaa/0002.p']) {
+    const preloaded = normalizeLazyFiles({ preloadAssets: [name] }, archives(BIG));
+    assert.strictEqual(preloaded.files[0].loadMode, 'required', `${name} -> 0002.p required`);
+    assert.strictEqual(preloaded.files[0].size, BIG, 'the size rides along for a HEAD-less mount');
+    assert.strictEqual(preloaded.files[1].loadMode, undefined, `${name} does not take 0003.p`);
+    assert.strictEqual(preloaded.files[2].httpRange, true, `${name} leaves 0005.p streaming`);
+  }
+
+  // A measured range list pins those bytes and nothing else, and the entry is
+  // still a lazy mount so the rest of the archive streams.
+  const ranges = { schemaVersion: 1, size: BIG, ranges: [[0, 4096], [8192, 12288]] };
+  const measured = normalizeLazyFiles(
+    { preloadAssets: ['0002.p'], preloadRanges: { '0002.p': ranges } }, archives(BIG));
+  assert.strictEqual(measured.files[0].loadMode, 'lazy');
+  assert.deepStrictEqual(measured.files[0].preloadRanges.ranges, ranges.ranges);
+  assert.strictEqual(measured.files[0].preloadRanges.size, BIG);
+  assert.strictEqual(measured.files[0].httpRange, undefined, 'a ranged preload is not a whole-file mount');
+
+  // Whole-file preloads are summed and warned about above the budget: a
+  // required 900 MB archive is a launch the user cannot start, and the shape
+  // that causes it (preloadAssets without measured ranges) is exactly what a
+  // registry entry gets before anyone has run the census.
+  {
+    const warnings = [];
+    const realWarn = console.warn;
+    console.warn = (msg) => warnings.push(String(msg));
+    let big;
+    try {
+      big = normalizeLazyFiles({ id: 'mbaa', preloadAssets: ['0002.p', '0003.p'] }, archives(BIG));
+    } finally { console.warn = realWarn; }
+    assert.strictEqual(big.summary.preloadWholeBytes, BIG * 2, 'the launch cost is reported');
+    assert.ok(warnings.some(w => /1040MB|\d+MB/.test(w) && /preloadRanges/.test(w)),
+      'and the warning names the sizes and the tool that fixes it');
+    // Below the budget there is nothing to say.
+    const quiet = [];
+    console.warn = (msg) => quiet.push(String(msg));
+    try {
+      normalizeLazyFiles({ preloadAssets: ['0002.p'] }, [
+        { url: 'binaries/mbaa/0002.p', size: 8 * 1024 * 1024, vfsPaths: ['c:\\0002.p'] },
+        { url: 'binaries/mbaa/0005.p', size: 512 * 1024 * 1024, vfsPaths: ['c:\\0005.p'] },
+      ], { sizeOf: f => (typeof f === 'object' ? f.size : null) });
+    } finally { console.warn = realWarn; }
+    assert.strictEqual(quiet.length, 0, 'a small whole-file preload is silent');
+  }
+
+  // A range list measured on a DIFFERENT file is refused, not pinned: the
+  // bytes would be wrong, and a wrong pin is worse than no pin.
+  const stale = normalizeLazyFiles(
+    { preloadAssets: ['0002.p'], preloadRanges: { '0002.p': { schemaVersion: 1, size: 1, ranges: [[0, 1]] } } },
+    archives(BIG));
+  assert.strictEqual(stale.files[0].loadMode, 'required',
+    'a size-mismatched range list falls back to the honest whole-file preload');
+
+  // A bare pairs array is accepted, and a function can decide per file.
+  const pairs = normalizeLazyFiles(
+    { preloadAssets: ['0002.p'], preloadRanges: { '0002.p': [[0, 16]] } }, archives(BIG));
+  assert.deepStrictEqual(pairs.files[0].preloadRanges.ranges, [[0, 16]]);
+  const byFn = normalizeLazyFiles(
+    { preloadAssets: ['0002.p', '0003.p'],
+      preloadRanges: (file) => (/0003/.test(file.url || file) ? [[0, 32]] : null) }, archives(BIG));
+  assert.strictEqual(byFn.files[0].loadMode, 'required', 'null from the function means whole file');
+  assert.deepStrictEqual(byFn.files[1].preloadRanges.ranges, [[0, 32]]);
+
+  // A directory entry preloads the tree it names.
+  const tree = normalizeLazyFiles({ preloadAssets: ['binaries/mbaa/'] }, archives(BIG));
+  assert(tree.files.every(f => f.loadMode === 'required'), 'a trailing separator takes the whole tree');
+
+  // A preload never overrides a file that already declared how it loads (the
+  // author's explicit loadMode wins), and an unrecognised name changes nothing.
+  const declared = [{ url: 'binaries/mbaa/0002.p', size: BIG, loadMode: 'background' }];
+  assert.strictEqual(normalizeLazyFiles({ preloadAssets: ['0002.p'] }, declared).files[0].loadMode,
+    'background', 'an explicit loadMode is not overridden');
+  assert.strictEqual(normalizeLazyFiles({ preloadAssets: ['nope.p'] }, archives(BIG)).files[0].httpRange,
+    true, 'an unmatched preload entry leaves the file streaming');
+}
+
 // Both hosts are wired to it.
 const read = file => fs.readFileSync(path.join(__dirname, '..', file), 'utf8');
-assert(/appFiles\.normalizeLazyFiles\(app, app\.files/.test(read('lib/browser-shell.js')), 'browser-shell applies the policy');
+// Wired, not spelled: the call may pass a per-launch override object (the
+// ?lazy-files path does), and pinning the exact argument list made a policy
+// test fail for a change that did not touch the policy.
+assert(/appFiles\.normalizeLazyFiles\(\w+, app\.files/.test(read('lib/browser-shell.js')), 'browser-shell applies the policy');
 assert(/require\('\.\.\/lib\/app-files'\)\.normalizeLazyFiles/.test(read('test/run.js')), 'run.js applies the policy');
 assert(/"lib\/app-files\.js"/.test(read('index.html')), 'index.html loads lib/app-files.js');
 
diff --git a/test/test-app-files-switches.js b/test/test-app-files-switches.js
new file mode 100644
index 000000000..ecaffeeab
--- /dev/null
+++ b/test/test-app-files-switches.js
@@ -0,0 +1,79 @@
+#!/usr/bin/env node
+'use strict';
+
+// The two launch-time policy switches, and the promise they make.
+//
+// `?eager-files` came first: it predates the lazy policy, and it is the
+// control arm for measuring that policy ("load everything, as before").
+// `?lazy-files` is the mirror image, added because `preloadAssets` can now
+// make a launch wait on a gigabyte of archives and someone on a slow link
+// needs a way out that is not "edit the registry". They are not symmetric, and
+// that asymmetry is the thing worth pinning:
+//
+//   ?eager-files  -> every file is downloaded before the first frame.
+//   ?lazy-files   -> the preload declarations are dropped; everything else
+//                    about the policy (eager extensions, persistFiles,
+//                    small-app shortcut) still applies.
+//
+// This drives the real policy function rather than the browser, so it is a
+// test of the contract those switches depend on.
+
+const assert = require('assert');
+const path = require('path');
+
+const { normalizeLazyFiles } = require('../lib/app-files');
+
+const MB = 1024 * 1024;
+const files = [
+  { url: 'binaries/mbaa/MBAA.exe', size: 4 * MB, vfsPaths: ['c:\\mbaa\\mbaa.exe'] },
+  { url: 'binaries/mbaa/0002.p', size: 900 * MB, vfsPaths: ['c:\\0002.p'] },
+  { url: 'binaries/mbaa/0003.p', size: 140 * MB, vfsPaths: ['c:\\0003.p'] },
+];
+const sizeOf = file => (typeof file === 'object' ? file.size : null);
+const app = { id: 'mbaa', preloadAssets: ['0002.p', '0003.p'] };
+
+// ---- the default: the declared archives are required at launch ------------
+{
+  const warned = [];
+  const realWarn = console.warn;
+  console.warn = m => warned.push(String(m));
+  let policy;
+  try { policy = normalizeLazyFiles(app, files, { sizeOf }); } finally { console.warn = realWarn; }
+
+  assert.strictEqual(policy.summary.policy, 'lazy');
+  const byUrl = Object.fromEntries(policy.files.map(f => [f.url, f]));
+  assert.strictEqual(byUrl['binaries/mbaa/0002.p'].loadMode, 'required',
+    'a declared preload is required at launch');
+  assert.strictEqual(byUrl['binaries/mbaa/0002.p'].size, 900 * MB,
+    'and carries its size so the mount needs no HEAD');
+  assert.strictEqual(byUrl['binaries/mbaa/MBAA.exe'].loadMode, undefined,
+    'the executable keeps the pre-policy classification');
+  assert.strictEqual(policy.summary.preloadWholeBytes, 1040 * MB,
+    'the whole launch cost is reported');
+  assert.ok(warned.length >= 1, 'and warned about, because it is a gigabyte');
+}
+
+// ---- ?lazy-files: declarations dropped, policy otherwise untouched --------
+{
+  const optedOut = { ...app, preloadAssets: [], preloadRanges: undefined };
+  const policy = normalizeLazyFiles(optedOut, files, { sizeOf });
+  const byUrl = Object.fromEntries(policy.files.map(f => [f.url, f]));
+
+  assert.strictEqual(byUrl['binaries/mbaa/0002.p'].loadMode, undefined,
+    'no file is forced to load at launch');
+  assert.strictEqual(byUrl['binaries/mbaa/0002.p'].httpRange, true,
+    'the archive streams instead, exactly as it did before preloadAssets');
+  assert.strictEqual(byUrl['binaries/mbaa/0003.p'].httpRange, true, 'and so does the other one');
+  assert.strictEqual(policy.summary.preloadWholeBytes, undefined,
+    'with nothing preloaded there is no launch cost to report');
+}
+
+// ---- the switch is a launch-time decision, and it says so in the URL ------
+const shell = require('fs').readFileSync(
+  path.join(__dirname, '..', 'lib', 'browser-shell.js'), 'utf8');
+assert.ok(/\[\?&\]lazy-files\(\?:\[=&\]\|\$\)/.test(shell),
+  'the switch is matched the same anchored way as ?eager-files');
+assert.ok(/preloadAssets: \[\], preloadRanges: undefined/.test(shell),
+  'and clears exactly the preload declarations, nothing else');
+
+console.log('PASS launch policy switches: ?lazy-files drops preloads, ?eager-files keeps loading everything');
diff --git a/test/test-d3d9-p8-conversion.js b/test/test-d3d9-p8-conversion.js
new file mode 100644
index 000000000..1f1581ece
--- /dev/null
+++ b/test/test-d3d9-p8-conversion.js
@@ -0,0 +1,152 @@
+#!/usr/bin/env node
+'use strict';
+
+// D3DFMT_P8 conversion: an indexed texture must sample through its palette.
+//
+// This is the half of the "completely white placeholder texture" report that
+// lives in JS. Before this change every P8 texel was uploaded as
+//   r = g = b = <index>, a = 255
+// i.e. the palette index drawn as a grey ramp, which reads as white wherever
+// a sprite's indices are high. On a fighting game whose sprite sheets are
+// paletted that is the whole character: a white silhouette.
+//
+// The conversion is exercised directly rather than through a GL context:
+// decodeTexturePixels is the one function the draw path calls, it is pure, and
+// the palette arrives as a plain 256-entry D3DCOLOR table (the device state the
+// WAT palette handlers write; see test/test-d3d9-palette-state.js).
+//
+// Also pinned here: the converter's contract for the other indexed/bit-depth
+// formats this engine advertises, because a change that makes P8 right must not
+// quietly move one of them.
+
+const assert = require('assert');
+const { decodeTexturePixels } = require('../lib/d3d9-host');
+
+const D3DFMT_P8 = 41;
+const D3DFMT_A8 = 28;
+const D3DFMT_L8 = 50;
+const D3DFMT_A8L8 = 51;
+const D3DFMT_R5G6B5 = 23;
+const D3DFMT_A1R5G5B5 = 25;
+const D3DFMT_A4R4G4B4 = 26;
+const D3DFMT_X8R8G8B8 = 22;
+const D3DFMT_A8R8G8B8 = 21;
+
+const ARGB = (a, r, g, b) => ((a << 24) | (r << 16) | (g << 8) | b) >>> 0;
+const rgbaAt = (pixels, i) => Array.from(pixels.slice(i * 4, i * 4 + 4));
+
+// A palette shaped like a real sprite sheet: index 0 is the transparent key,
+// the rest are distinct colours, the last 240..255 are a bright ramp (the
+// "white" end the old code smeared across the sprite).
+function sheetPalette() {
+  const palette = new Uint32Array(256);
+  // The key colour is colour-free AND transparent. Note this engine reads an
+  // all-zero entry as "never written" and shows it opaque black (case 2), so a
+  // real key is expressed as alpha 0 with a set colour -- which is also what a
+  // sprite sheet's exporter writes.
+  palette[0] = 0x00000001;                       // key colour: alpha 0, RGB set
+  for (let i = 1; i < 240; i++) palette[i] = ARGB(255, i, (i * 5) & 255, (255 - i) & 255);
+  for (let i = 240; i < 256; i++) palette[i] = ARGB(255, 255, 250 + ((i - 240) % 6), 240);
+  return palette;
+}
+
+// 1. The report's symptom, exactly: a 4x1 strip whose indices happen to be
+//    bright must show its PALETTE colours, not white.
+{
+  const palette = sheetPalette();
+  const src = new Uint8Array([0, 1, 128, 250]);
+  const pixels = decodeTexturePixels(D3DFMT_P8, src, 4, 1, palette);
+  assert.strictEqual(pixels.length, 16);
+  // index 0 -> the key colour, transparent (a sprite's cut-out must survive)
+  // (alpha 0 with a non-zero colour: an unset entry, 0x00000000, is shown
+  //  opaque black instead -- case 2 pins that.)
+  assert.deepStrictEqual(rgbaAt(pixels, 0), [0, 0, 1, 0], 'index 0 is the transparent key');
+  // index 1 -> palette entry 1, byte by byte, not the index
+  assert.deepStrictEqual(rgbaAt(pixels, 1), [1, 5, 254, 255], 'index 1 resolves through the palette');
+  // index 128 -> a mid colour, and crucially NOT (128,128,128,255)
+  assert.deepStrictEqual(rgbaAt(pixels, 2), [128, 128, 127, 255]);
+  assert.notDeepStrictEqual(rgbaAt(pixels, 2), [128, 128, 128, 255],
+    'the upload must not be the index as luminance');
+  // index 250 -> the bright end of the palette (240 + (250-240)%6 green)
+  assert.deepStrictEqual(rgbaAt(pixels, 3), [255, 254, 240, 255]);
+  // Every opaque texel is NOT full white: the old conversion could not say
+  // this, and it is the actual measured difference on a white sprite.
+  const opaque = [0, 1, 2, 3].map(i => rgbaAt(pixels, i)).filter(p => p[3] === 255);
+  assert.ok(opaque.some(p => p[0] !== 255 || p[1] !== 255 || p[2] !== 255),
+    'a paletted strip is not uniformly white');
+}
+
+// 2. Alpha is taken from the palette's top byte, and an all-zero entry is
+//    opaque black rather than invisible: a cleared palette table must not
+//    turn a whole sprite into a no-op.
+{
+  const palette = new Uint32Array(256);          // never written
+  const pixels = decodeTexturePixels(D3DFMT_P8, new Uint8Array([7]), 1, 1, palette);
+  assert.deepStrictEqual(rgbaAt(pixels, 0), [0, 0, 0, 255],
+    'an unwritten palette entry is opaque black, not transparent');
+  palette[9] = ARGB(0, 200, 100, 50);            // explicit alpha 0, colour set
+  assert.deepStrictEqual(
+    rgbaAt(decodeTexturePixels(D3DFMT_P8, new Uint8Array([9]), 1, 1, palette), 0),
+    [200, 100, 50, 0], 'a set colour with alpha 0 stays transparent');
+  palette[10] = ARGB(128, 10, 20, 30);
+  assert.deepStrictEqual(
+    rgbaAt(decodeTexturePixels(D3DFMT_P8, new Uint8Array([10]), 1, 1, palette), 0),
+    [10, 20, 30, 128], 'partial alpha passes through untouched');
+}
+
+// 3. The byte-length gate stays a gate: a short P8 source is refused, not
+//    silently over-read (that over-read would read palette bytes as indices).
+{
+  assert.throws(() => decodeTexturePixels(D3DFMT_P8, new Uint8Array(3), 4, 1, sheetPalette()),
+    /invalid texture byte length/);
+}
+
+// 4. Format contract for the formats whose conversion shares this function,
+//    pinned so a P8 fix cannot move them silently.
+{
+  // A8: colour is white, alpha is the source byte.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_A8, new Uint8Array([0, 128, 255]), 3, 1), 1),
+    [255, 255, 255, 128]);
+  // L8: luminance on all three channels, opaque.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_L8, new Uint8Array([77]), 1, 1), 0),
+    [77, 77, 77, 255]);
+  // A8L8: luminance in the LOW byte, alpha in the high one.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_A8L8, new Uint8Array([77, 200]), 1, 1), 0),
+    [77, 77, 77, 200]);
+  // R5G6B5: channels replicated into the high bits, so all-ones reaches 255.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_R5G6B5, new Uint8Array([0xff, 0xff]), 1, 1), 0),
+    [255, 255, 255, 255]);
+  // A1R5G5B5: the top bit is alpha.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_A1R5G5B5, new Uint8Array([0x00, 0x00]), 1, 1), 0),
+    [0, 0, 0, 0]);
+  // A4R4G4B4: nibble times 17 spans 0..255 exactly. Little-endian word, so
+  // the LOW nibble is blue: 0xF00F is alpha F, red 0, green 0, blue F.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_A4R4G4B4, new Uint8Array([0x0f, 0xf0]), 1, 1), 0),
+    [0, 0, 255, 255], 'A4R4G4B4 low nibble is blue, top nibble is alpha');
+  // 0x0FFF: alpha 0 (top nibble of the high byte), red F, green F, blue F.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_A4R4G4B4, new Uint8Array([0xff, 0x0f]), 1, 1), 0),
+    [255, 255, 255, 0], 'A4R4G4B4 keeps its alpha nibble');
+  // xRGB: stored blue-first (D3D), no alpha channel to read.
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_X8R8G8B8, new Uint8Array([30, 20, 10, 0xEE]), 1, 1), 0),
+    [10, 20, 30, 255], 'X8R8G8B8 is opaque regardless of the fourth byte');
+  assert.deepStrictEqual(rgbaAt(decodeTexturePixels(D3DFMT_A8R8G8B8, new Uint8Array([30, 20, 10, 0xEE]), 1, 1), 0),
+    [10, 20, 30, 0xEE], 'A8R8G8B8 keeps its alpha');
+}
+
+// 5. A 3x2 sheet is row-major with no padding surprises: sprite sheets are
+//    almost never power-of-two-square in the sheets MBAACC uses.
+{
+  const palette = sheetPalette();
+  const src = new Uint8Array([0, 1, 2, 3, 4, 5]);
+  const pixels = decodeTexturePixels(D3DFMT_P8, src, 3, 2, palette);
+  const resolve = (c) => {
+    const a = (c >>> 24) & 255;
+    return [(c >>> 16) & 255, (c >>> 8) & 255, c & 255, a === 0 && c === 0 ? 255 : a];
+  };
+  for (let i = 0; i < 6; i++) {
+    assert.deepStrictEqual(rgbaAt(pixels, i), resolve(palette[i]),
+      `texel ${i} lands at its row-major slot`);
+  }
+}
+
+console.log('PASS D3DFMT_P8 resolves through its palette; other format conversions unchanged');
diff --git a/test/test-d3d9-palette-state.js b/test/test-d3d9-palette-state.js
new file mode 100644
index 000000000..f2ff6f231
--- /dev/null
+++ b/test/test-d3d9-palette-state.js
@@ -0,0 +1,159 @@
+#!/usr/bin/env node
+'use strict';
+
+// D3DFMT_P8 is an INDEXED format, and an indexed texture is only meaningful
+// through a palette. Two things had to be true for the "completely white
+// placeholder texture" report, and both were false:
+//
+//   1. the device stored no palette at all -- SetPaletteEntries returned
+//      D3D_OK while storing nothing, so a game could neither write nor read
+//      back what it had written; and
+//   2. lib/d3d9-host.js uploaded the index byte as luminance
+//      (r = g = b = index, a = 255), so a paletted sprite drew as a grey ramp
+//      of its own indices and went white wherever the indices are high.
+//
+// This pins the WAT half: the storage the host reads, its addressing, the
+// clamp SetCurrentTexturePalette is documented to apply, the copy semantics of
+// both directions, and the refused-device path. The conversion half is pinned
+// by test-d3d9-p8-conversion.js, which draws and reads the pixels back.
+//
+// The LAYOUT is a contract with lib/d3d9-host.js, which resolves P8 by reading
+// `state+26012` (current palette number) and `state+26016 + 1024*number`
+// (256 D3DCOLORs, 0xAARRGGBB) as guest addresses. If either side moves, this
+// test is the thing that says so.
+//
+// These offsets are AFTER the historical device block, which ends at +26012.
+// They were originally +25616/+25620, which collided with the render-target
+// slots 1-3 and pixel constants c8-c31 that this build really uses (and that
+// lib/d3d9-host.js reads) -- the palettes were moved rather than overlaid.
+
+const assert = require('assert');
+const { bootRenderHarness } = require('./render-helper');
+
+const D3D_OK = 0;
+const D3DERR_INVALIDCALL = 0x8876086C;
+const PALETTE_SLOT = 26012;   // current palette number
+const PALETTE_BASE = 26016;   // 16 x 1024 bytes
+const ENTRY_BYTES = 1024;
+
+const ARGB = (a, r, g, b) => ((a << 24) | (r << 16) | (g << 8) | b) >>> 0;
+
+(async () => {
+  const { exports: e } = await bootRenderHarness({ fonts: 'none', extraWat: `
+    (func (export "new_device") (result i32)
+      (local $device i32)
+      (local.set $device (call $dx_create_com_obj (i32.const 20) (global.get $DX_VTBL_D3DDEV9)))
+      (store.field DxObject misc1 (call $dx_from_this (local.get $device)) (call $d3d9_program_alloc))
+      (local.get $device))
+    ;; The stdcall convention every handler in this tree uses: read the args
+    ;; from the guest stack at ESP+4, +8, ... so the handler can pop its own
+    ;; frame. ESP is staged with set_esp from the JS side (see below).
+    (func (export "set_palette") (result i32)
+      (call $handle_IDirect3DDevice9_SetPaletteEntries
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 4)))
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 8)))
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 12)))
+        (i32.const 0) (i32.const 0) (i32.const 0))
+      (i32.load offset=0 (global.get $reg_base)))
+    (func (export "get_palette") (result i32)
+      (call $handle_IDirect3DDevice9_GetPaletteEntries
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 4)))
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 8)))
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 12)))
+        (i32.const 0) (i32.const 0) (i32.const 0))
+      (i32.load offset=0 (global.get $reg_base)))
+    (func (export "set_current") (result i32)
+      (call $handle_IDirect3DDevice9_SetCurrentTexturePalette
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 4)))
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 8)))
+        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
+      (i32.load offset=0 (global.get $reg_base)))
+    (func (export "get_current") (result i32)
+      (call $handle_IDirect3DDevice9_GetCurrentTexturePalette
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 4)))
+        (call $gl32 (i32.add (i32.load offset=16 (global.get $reg_base)) (i32.const 8)))
+        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0))
+      (i32.load offset=0 (global.get $reg_base)))
+    (func (export "state") (param $d i32) (result i32)
+      (call $d3d9_program_state (local.get $d)))
+  ` });
+
+  e.init_dx_com_thunks();
+  const d = e.new_device();
+  assert.ok(d, 'device created');
+  const state = e.state(d) >>> 0;
+  assert.ok(state, 'device program state is guest-addressable');
+
+  const out = 0x00410000;             // scratch, well clear of engine memory
+  // Handlers read their arguments from the guest stack at ESP+4. Stage a
+  // stdcall frame the way the dispatcher does, then call the thunk body.
+  const STACK = 0x0040F000;
+  const call = (fn, ...args) => {
+    e.set_esp(STACK);
+    for (let i = 0; i < args.length; i++) e.guest_write32(STACK + 4 + i * 4, args[i] | 0);
+    return e[fn]() >>> 0;
+  };
+  const palette = new Uint32Array(256);
+  for (let i = 0; i < 256; i++) palette[i] = ARGB(i === 0 ? 0 : 255, i, (i * 3) & 255, 255 - i);
+
+  // 1. Write palette 3 and read it back through the sibling getter.
+  for (let i = 0; i < 256; i++) e.guest_write32(out + i * 4, palette[i] | 0);
+  assert.strictEqual(call('set_palette', d, 3, out), D3D_OK, 'SetPaletteEntries(3) returns D3D_OK');
+  // ...and through the layout the host reads, which is the part that matters.
+  const base = state + PALETTE_BASE + 3 * ENTRY_BYTES;
+  for (const index of [0, 1, 2, 77, 254, 255]) {
+    assert.strictEqual(e.guest_read32(base + index * 4) >>> 0,
+      palette[index], `palette 3 entry ${index} stored`);
+  }
+  // The neighbours are untouched: 1024 bytes exactly, no spill over.
+  assert.strictEqual(e.guest_read32(state + PALETTE_BASE + 2 * ENTRY_BYTES + 1020) >>> 0, 0,
+    'palette 2 stays zero after writing palette 3');
+  for (let i = 0; i < 256; i++) e.guest_write32(out + i * 4, 0xDEADBEEF);
+  assert.strictEqual(call('get_palette', d, 3, out), D3D_OK, 'GetPaletteEntries(3) returns D3D_OK');
+  for (const index of [0, 128, 255]) {
+    assert.strictEqual(e.guest_read32(out + index * 4) >>> 0, palette[index],
+      `GetPaletteEntries round-trips entry ${index}`);
+  }
+
+  // 2. Sixteen independent palettes; the sixteenth is the last addressable one.
+  for (let n = 0; n < 16; n++) {
+    for (let i = 0; i < 256; i++) e.guest_write32(out + i * 4, ARGB(255, n, n, n) | 0);
+    assert.strictEqual(call('set_palette', d, n, out), D3D_OK, `palette ${n} accepted`);
+    assert.strictEqual(e.guest_read32(state + PALETTE_BASE + n * ENTRY_BYTES) >>> 0,
+      ARGB(255, n, n, n), `palette ${n} stored at its own slot`);
+  }
+  assert.strictEqual(call('set_palette', d, 16, out), D3DERR_INVALIDCALL,
+    'a seventeenth palette is refused, not silently wrapped');
+
+  // 3. The current-palette selector: stored, read back, and D3D9's documented
+  //    clamp for an out-of-range number (D3D9 says the system palette; we
+  //    clamp, which keeps the last defined palette rather than an undefined
+  //    pointer -- the audit comment in lib/d3d9-host.js says why).
+  assert.strictEqual(call('set_current', d, 5), D3D_OK);
+  assert.strictEqual(call('get_current', d, out), D3D_OK);
+  assert.strictEqual(e.guest_read32(out) >>> 0, 5, 'GetCurrentTexturePalette reads what was set');
+  e.guest_write32(out, 0xFFFFFFFF);
+  assert.strictEqual(call('set_current', d, 999), D3D_OK, 'out-of-range selection does not fail');
+  assert.strictEqual(call('get_current', d, out), D3D_OK);
+  assert.strictEqual(e.guest_read32(out) >>> 0, 999, 'the raw number is preserved for the reader');
+
+  // 4. A NULL entry list is success with no change (D3D9's behaviour for a
+  //    null source), not a crash and not a cleared palette.
+  const before = e.guest_read32(state + PALETTE_BASE + 7 * ENTRY_BYTES) >>> 0;
+  assert.strictEqual(call('set_palette', d, 7, 0), D3D_OK, 'NULL entries is success');
+  assert.strictEqual(e.guest_read32(state + PALETTE_BASE + 7 * ENTRY_BYTES) >>> 0, before,
+    'NULL entries leaves the palette alone');
+
+  // 5. A device that is not a D3D9 device is refused, not dereferenced.
+  assert.strictEqual(call('set_palette', 0, 0, out), D3DERR_INVALIDCALL);
+  assert.strictEqual(call('get_palette', 0, 0, out), D3DERR_INVALIDCALL);
+  assert.strictEqual(call('get_current', 0, out), D3DERR_INVALIDCALL);
+
+  // 6. The allocation is still the ONE the build gates size: 42400 bytes,
+  //    i.e. exactly 16 palettes after the selector at +26012. A short
+  //    allocation would let palette 15 write past the heap block.
+  assert.strictEqual(PALETTE_BASE + 16 * ENTRY_BYTES, 42400,
+    'the palette block ends exactly where d3d9_program_alloc stops allocating');
+
+  console.log('PASS D3D9 texture palettes: 16 slots, copy both ways, selector clamp, NULL entries, bad device');
+})().catch(err => { console.error(err); process.exit(1); });
