diff --git a/test/test-mbaa-texture-census.js b/test/test-mbaa-texture-census.js
new file mode 100644
index 000000000..96a569636
--- /dev/null
+++ b/test/test-mbaa-texture-census.js
@@ -0,0 +1,164 @@
+#!/usr/bin/env node
+'use strict';
+
+// tools/mbaa-texture-census.js: the range list it emits is the one thing a
+// launch will PIN, so the tool's two failure modes matter more than its happy
+// path:
+//
+//   * classify a non-texture member as a texture  -> launch downloads bytes it
+//     did not need (the whole point of the range list is that it is small);
+//   * misparse the container and emit ranges     -> launch pins the WRONG
+//     bytes, and a texture that is resident but wrong is worse than one that
+//     streams. So a parse failure must exit non-zero and write nothing.
+//
+// This drives the real CLI against synthetic archives built in the temp dir,
+// including an archive whose name table needs the second advance rule. Both
+// layouts are exercised because the .p container is the one shape this tree
+// does not otherwise parse: the tool decides the rule empirically (the cursor
+// must land exactly on the first member's data) rather than trusting a
+// convention.
+
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { execFileSync } = require('child_process');
+const { preloadRangesFor } = require('../lib/byte-provider');
+
+const TOOL = path.join(__dirname, '..', 'tools', 'mbaa-texture-census.js');
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'mbaa-census-'));
+
+// A synthesised member: an 8-byte-image header (w, h, format, payload length)
+// followed by `payload` bytes of indices. format 0 = 8bpp, so payload = w*h.
+function textureMember(w, h, fill) {
+  const head = Buffer.alloc(16);
+  head.writeUInt32LE(w, 0); head.writeUInt32LE(h, 4);
+  head.writeUInt32LE(0, 8); head.writeUInt32LE(w * h, 12);
+  return Buffer.concat([head, Buffer.alloc(w * h, fill)]);
+}
+function otherMember(bytes) { return Buffer.alloc(bytes, 0x22); }
+
+// `shape` A: names NUL-terminated, stored length EXCLUDES the terminator.
+// `shape` B: '\0name', stored length EXCLUDES the leading NUL (so the cursor
+// step is length + 1 as well, but the 1 is the prefix -- the tool's rule is
+// empirical, which is the point of testing both).
+function writeArchive(file, members, shape) {
+  const n = members.length;
+  const names = shape === 'A'
+    ? Buffer.concat(members.map(m => Buffer.from(m.name + '\0', 'latin1')))
+    : Buffer.concat(members.map(m => Buffer.from('\0' + m.name, 'latin1')));
+  const namesAt = 16, tableLength = n * 8;
+  const dataAt = namesAt + tableLength + names.length;
+  let at = dataAt;
+  const entries = [];
+  for (const m of members) {
+    entries.push([at, m.name.length + (shape === 'A' ? 1 : 1)]);
+    at += m.data.length;
+  }
+  // ...but the STEP that lands on dataAt is a property of the shape, and for
+  // B it is the same length+1 because the prefix is not counted.
+  const header = Buffer.alloc(16);
+  header.writeUInt32LE(n, 4); header.writeUInt32LE(namesAt, 8); header.writeUInt32LE(dataAt, 12);
+  const table = Buffer.alloc(tableLength);
+  entries.forEach(([offset, length], i) => {
+    table.writeUInt32LE(offset, i * 8);
+    table.writeUInt32LE(length, i * 8 + 4);
+  });
+  fs.writeFileSync(file, Buffer.concat([header, table, names, ...members.map(m => m.data)]));
+  return { dataAt, names };
+}
+
+function run(file, ...extra) {
+  try {
+    const stdout = execFileSync(process.execPath, [TOOL, file, ...extra], { encoding: 'utf8' });
+    return { code: 0, stdout };
+  } catch (error) {
+    return { code: error.status || 1, stdout: String(error.stdout || ''), stderr: String(error.stderr || '') };
+  }
+}
+
+const members = [
+  { name: 'spr_a.bin', data: textureMember(8, 8, 0x11) },
+  { name: 'bgm.dat', data: otherMember(1000) },
+  { name: 'spr_b.bin', data: textureMember(16, 16, 0x33) },
+];
+
+for (const shape of ['A', 'B']) {
+  const archive = path.join(dir, `shape-${shape}.p`);
+  const out = path.join(dir, `shape-${shape}.json`);
+  const { dataAt } = writeArchive(archive, members, shape);
+  const result = run(archive, `--out=${out}`);
+  assert.strictEqual(result.code, 0, `shape ${shape} parses: ${result.stderr}`);
+  const list = JSON.parse(fs.readFileSync(out, 'utf8'));
+
+  // The list is the preloadRangesFor() contract, so prove it is readable by the
+  // consumer rather than just well-shaped.
+  const size = fs.statSync(archive).size;
+  assert.strictEqual(list.schemaVersion, 1);
+  assert.strictEqual(list.size, size, 'the measured size is the file size');
+  const ranges = preloadRangesFor(list, size);
+  assert.ok(ranges.length >= 1, 'preloadRangesFor accepts the emitted list');
+
+  // Two texture members, the 1000-byte BGM member NOT pinned, and every pinned
+  // byte is inside the archive.
+  const pinned = ranges.reduce((sum, r) => sum + (r[1] - r[0]), 0);
+  assert.strictEqual(pinned, 80 + 272, `shape ${shape}: only the two texture members are pinned`);
+  assert.ok(pinned < size, 'the range list is smaller than the archive');
+  for (const [start, end] of ranges) {
+    assert.ok(start >= dataAt && end <= size, 'a pinned range stays inside the data area');
+  }
+  // The other member's bytes are not covered by any range.
+  const other = dataAt + 80;
+  assert.ok(!ranges.some(([start, end]) => start <= other && end > other),
+    'the non-texture member is left streaming');
+}
+
+// A truncated/corrupt table must FAIL, and must not leave a range list behind:
+// a launch that pins garbage is worse than a launch that streams.
+for (const [label, corrupt] of [
+  ['count beyond EOF', buf => { buf.writeUInt32LE(9999, 4); return buf; }],
+  ['name table outside the file', buf => { buf.writeUInt32LE(buf.length + 0x1000, 8); return buf; }],
+  ['data offset before the name table', buf => { buf.writeUInt32LE(4, 12); return buf; }],
+  ['truncated member table', buf => buf.subarray(0, 20)],
+]) {
+  const archive = path.join(dir, `bad-${label.replace(/\W+/g, '-')}.p`);
+  const out = path.join(dir, `bad-${label.replace(/\W+/g, '-')}.json`);
+  const base = path.join(dir, 'shape-A.p');
+  fs.writeFileSync(archive, corrupt(fs.readFileSync(base)));
+  const result = run(archive, `--out=${out}`);
+  assert.notStrictEqual(result.code, 0, `${label}: the tool must exit non-zero`);
+  assert.ok(!fs.existsSync(out), `${label}: no range list is written`);
+  assert.ok(/not a \.p archive|no name-table advance rule/.test(result.stderr),
+    `${label}: the message names the problem`);
+}
+
+// The pin bound is a bound: a list that would pin more than --max-mb fails
+// loudly instead of quietly turning a "few tens of MB" preload into the whole
+// archive (which is what preloadAssets is for).
+{
+  const archive = path.join(dir, 'too-big.p');
+  writeArchive(archive, [
+    { name: 'a.bin', data: textureMember(64, 64, 1) },
+    { name: 'b.bin', data: textureMember(64, 64, 2) },
+  ], 'A');
+  const result = run(archive, '--max-mb=0', `--out=${path.join(dir, 'too-big.json')}`);
+  assert.notStrictEqual(result.code, 0, 'over the pin bound is a failure');
+  assert.ok(!fs.existsSync(path.join(dir, 'too-big.json')), 'and writes nothing');
+}
+
+// --list and --json are diagnostics and must not need --out.
+{
+  const list = run(path.join(dir, 'shape-A.p'), '--json');
+  assert.strictEqual(list.code, 0, list.stderr);
+  const parsed = JSON.parse(list.stdout);
+  assert.strictEqual(parsed.textureMembers, 2);
+  assert.strictEqual(parsed.otherMembers, 1);
+  assert.ok(parsed.list.some(m => m.kind === 'texture:raw' && m.name === 'spr_a.bin'));
+  // --list alone is the human form and must mention the classification.
+  const human = run(path.join(dir, 'shape-A.p'), '--list');
+  assert.strictEqual(human.code, 0);
+  assert.ok(/texture:raw/.test(human.stdout) && /bgm\.dat/.test(human.stdout));
+}
+
+fs.rmSync(dir, { recursive: true, force: true });
+console.log('PASS mbaa texture census: both .p name-table shapes, texture-only ranges, corrupt archives refused');
diff --git a/test/test-perf-hud-waiting.js b/test/test-perf-hud-waiting.js
new file mode 100644
index 000000000..2d43eb9b9
--- /dev/null
+++ b/test/test-perf-hud-waiting.js
@@ -0,0 +1,106 @@
+#!/usr/bin/env node
+'use strict';
+
+// The waiting lines on the perf HUD (lib/perf-hud.js).
+//
+// GitHub issue #3 reports Character Select / Options at ~20 FPS against 60 in
+// battle, with the first visit to a menu always slow. Two mechanisms fit, and
+// the fix for one does nothing for the other:
+//
+//   * the guest spinning on a clock or an empty queue and paying a scheduler
+//     turn per spin ($clock_spin_parks / $peek_spin_parks), or
+//   * the guest blocked on a lazy chunk that was not resident yet
+//     ($lazy_fill_count), which is first-visit-only by nature.
+//
+// So the HUD has to show both rates, and has to show them as a *rate*: a
+// cumulative count that only grows tells you nothing about the current screen.
+// The arithmetic is the part worth testing (wrap, missing samples, first
+// sample), which is what this does, against the real class.
+
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+
+const ROOT = path.join(__dirname, '..');
+
+// lib/perf-hud.js is a browser file: it defines a class and hangs it off a
+// global. Load it in a sandbox with just enough of a window to exist.
+const sandbox = {
+  console,
+  setTimeout: () => 0,
+  clearInterval: () => {},
+  setInterval: () => 0,
+  performance: { now: () => Date.now() },
+  navigator: {},
+  location: { search: '' },
+  document: null,
+  window: null,
+  URLSearchParams,
+  Date,
+  Math,
+  Promise,
+};
+sandbox.globalThis = sandbox;
+sandbox.window = sandbox;
+vm.createContext(sandbox);
+vm.runInContext(fs.readFileSync(path.join(ROOT, 'lib', 'perf-hud.js'), 'utf8'), sandbox,
+  { filename: 'lib/perf-hud.js' });
+// The file exports a singleton (`global.WinePerf`), not the class. Its state
+// is per-instance, but only the rates are exercised here, so the singleton is
+// the right object: it is what host.js actually calls.
+const hud = sandbox.WinePerf;
+assert.ok(hud && typeof hud._guestRate === 'function', 'the HUD singleton is exported');
+
+// --- no samples at all -----------------------------------------------------
+assert.strictEqual(hud._guestRate('get_clock_spin_parks'), 0, 'no sample -> 0, not NaN');
+assert.ok(!Number.isNaN(hud._guestRate('get_lazy_fill_count')), 'still a number');
+
+// --- one sample: a rate needs two ------------------------------------------
+hud._guestCounters = { at: 1000, app: 'mbaa', values: { get_clock_spin_parks: 500 } };
+assert.strictEqual(hud._guestRate('get_clock_spin_parks'), 0, 'a first sample cannot make a rate');
+
+// --- the ordinary case: 300 parks over 2 s ---------------------------------
+hud._guestCounters = {
+  at: 3000, app: 'mbaa', previous: hud._guestCounters,
+  values: { get_clock_spin_parks: 800 },
+};
+assert.strictEqual(hud._guestRate('get_clock_spin_parks'), 150, '300 parks in 2s is 150/s');
+
+// --- the counters are i32: they wrap, and a wrap must not read as negative --
+hud._guestCounters = {
+  at: 4000, app: 'mbaa', previous: { at: 3000, values: { get_clock_spin_parks: 0xfffffffe } },
+  values: { get_clock_spin_parks: 2 },
+};
+assert.strictEqual(hud._guestRate('get_clock_spin_parks'), 4, 'a wrapped counter still measures 4/s');
+
+// --- a counter the export table does not have is simply absent ------------
+hud._guestCounters = {
+  at: 5000, app: 'mbaa', previous: { at: 4000, values: {} },
+  values: {},
+};
+assert.strictEqual(hud._guestRate('get_lazy_fill_count'), 0, 'a missing exporter reads 0');
+
+// --- a degenerate window (same timestamp) must not divide by zero ---------
+hud._guestCounters = {
+  at: 6000, app: 'mbaa', previous: { at: 6000, values: { get_lazy_fill_count: 1 } },
+  values: { get_lazy_fill_count: 5 },
+};
+assert.strictEqual(hud._guestRate('get_lazy_fill_count'), 0, 'a zero-length window reads 0');
+
+// --- the sampler must actually ask for the counters -----------------------
+const source = fs.readFileSync(path.join(ROOT, 'lib', 'perf-hud.js'), 'utf8');
+const namesBlock = source.slice(source.indexOf("const names = ['"), source.indexOf('];', source.indexOf("const names = ['")));
+for (const name of ['get_clock_spin_parks', 'get_peek_spin_parks', 'get_lazy_fill_count']) {
+  assert.ok(namesBlock.includes(`'${name}'`), `the sampler reads ${name}`);
+}
+
+// --- and the guest must publish the fill counter the host maintains -------
+const guestExports = fs.readFileSync(path.join(ROOT, 'src', '13-exports.wat'), 'utf8');
+assert.ok(/\(export "get_lazy_fill_count"\)/.test(guestExports), 'the getter is exported');
+assert.ok(/\(export "set_lazy_fill_count"\)/.test(guestExports), 'the setter is exported');
+const hostSource = fs.readFileSync(path.join(ROOT, 'host.js'), 'utf8');
+assert.ok(/_publishLazyFills\(\)/.test(hostSource), 'the host publishes the counter');
+assert.ok(/set_lazy_fill_count/.test(hostSource), 'through the guest export');
+
+console.log('PASS perf HUD waiting lines: park/s and fill/s are rates, wrap-safe and NaN-free');
diff --git a/test/test-readfile-park-idempotence.js b/test/test-readfile-park-idempotence.js
new file mode 100644
index 000000000..ce61645dc
--- /dev/null
+++ b/test/test-readfile-park-idempotence.js
@@ -0,0 +1,133 @@
+#!/usr/bin/env node
+'use strict';
+
+// A parked read is not a completed read.
+//
+// When a provider-backed chunk is not resident, the host returns 997 and the
+// guest re-enters the exact same call after the fill. The guest's own memory is
+// live across that park (the parked stdcall frame is replayed rather than
+// re-created, and a nested run can deliver a callback while it is parked), so
+// anything the host writes on the abandoning attempt is visible and stays
+// visible. The dangerous write is the byte count: a 0 there is not "no bytes"
+// -- it is "this call has not happened yet" -- and a guest that samples it
+// draws a string truncated to whatever the previous, shorter read left behind.
+// That is the reported pre-battle dialogue ("The", then "Th", then "The..."):
+// the text is re-read from the file every frame, the file streams its chunks
+// lazily, and each park published a count the guest could not tell from EOF.
+//
+// The contract asserted below, for BOTH read entry points:
+//   * a park (997) leaves *lpBytesRead exactly as it found it;
+//   * repeated parks (a slow fill) keep leaving it alone;
+//   * a real completion writes the real count -- the fix is "don't lie while
+//     parked", not "never publish".
+
+const assert = require('assert');
+
+const { VirtualFS, createFilesystemImports } = require('../lib/filesystem');
+const RegionMap = require('../lib/region-map.generated');
+
+const GUEST = 'c:\\dialogue.dat';
+const IMAGE_BASE = 0x400000;
+const BUFFER = 0x400000;
+const COUNT_SLOT = 0x401000;
+const STALE = 0x5a5a;
+
+function harness() {
+  const vfs = new VirtualFS();
+  let resident = false;
+  let fills = 0;
+  vfs.setProviderFile(GUEST, {
+    provider: {
+      size: 64,
+      // Once anything has been filled, everything is resident. Pinning the
+      // chunk boundaries here would make the test depend on the cache's chunk
+      // size rather than on the park contract it exists to assert.
+      tryRead: (off, len) => (resident
+        ? new Uint8Array(len).fill(0).map((_, i) => (off + i) & 0xff)
+        : null),
+      fill: async () => { fills++; resident = true; },
+    },
+  });
+  // 100 pages = 6.25 MB: the guest window the addresses below translate
+  // into has to fit in linear memory or every DataView read is out of range.
+  const memory = new WebAssembly.Memory({ initial: 100 });
+  const imports = createFilesystemImports({
+    vfs,
+    getMemory: () => memory.buffer,
+    exports: { get_image_base: () => IMAGE_BASE },
+  });
+  const handle = vfs.createFile(GUEST, 0x80000000, 3 /* OPEN_EXISTING */);
+  assert.ok(handle, 'the archive is openable');
+  // Guest addresses are translated through the image base, exactly as the host
+  // does; reading the raw linear address would be reading someone else's page.
+  const view = () => new DataView(memory.buffer);
+  const countAt = () => view().getUint32(RegionMap.g2w(COUNT_SLOT, IMAGE_BASE), true);
+  const seedCount = (value) => view().setUint32(RegionMap.g2w(COUNT_SLOT, IMAGE_BASE), value, true);
+  return { vfs, imports, handle, fillCount: () => fills, countAt, seedCount };
+}
+
+// The two entry points report a park differently, and that difference is part
+// of the contract: the Win32-shaped fs_read_file_at returns the operation
+// result (997 = re-enter after the fill), while the legacy BOOL fs_read_file
+// returns 0 and puts the park in fs_read_pending(). Both must be silent about
+// the byte count until they complete.
+const cases = [
+  ['positional fs_read_file_at', {
+    call: (imports, handle, nRead) => imports.fs_read_file_at(handle, BUFFER, 16, nRead, 0, 0, 1),
+    parked: (result, imports) => result === 997,
+    done: (result) => result === 0,
+  }],
+  ['cursor-moving fs_read_file', {
+    call: (imports, handle, nRead) => imports.fs_read_file(handle, BUFFER, 16, nRead, 1),
+    parked: (result, imports) => result === 0 && imports.fs_read_pending(1) === 1,
+    done: (result) => result === 1,
+  }],
+];
+
+async function parkCase([label, mode]) {
+  const call = mode.call;
+  const { vfs, imports, handle, countAt, seedCount } = harness();
+
+  seedCount(STALE);
+
+  assert.ok(mode.parked(call(imports, handle, COUNT_SLOT), imports),
+    `${label}: the first read parks`);
+  assert.strictEqual(countAt(), STALE,
+    `${label}: a park must not publish a byte count the guest never earned`);
+
+  assert.ok(mode.parked(call(imports, handle, COUNT_SLOT), imports),
+    `${label}: the slow fill parks again`);
+  assert.strictEqual(countAt(), STALE,
+    `${label}: repeated parks stay silent too`);
+
+  const pending = vfs.getPendingRead(1) || vfs.pendingRead;
+  assert.ok(pending, `${label}: a pending fill is recorded for the retry`);
+  const filled = await vfs.fillPendingRead(pending);
+  assert.strictEqual(filled, true, `${label}: the fill succeeds`);
+
+  assert.ok(mode.done(call(imports, handle, COUNT_SLOT)),
+    `${label}: the retried read completes`);
+  assert.strictEqual(countAt(), 16,
+    `${label}: a completed read publishes its real count`);
+}
+
+async function main() {
+  for (const c of cases) await parkCase(c);
+
+  // The same rule at the guest boundary: the WAT wrapper must not clear the
+  // caller's lpBytesRead on the way in either, or the first frame of a streamed
+  // file still reads as an empty string even once the park contract is right.
+  const source = require('fs').readFileSync(require('path').join(__dirname, '..',
+    'src', '09a7d-handlers-shell-file.wat'), 'utf8');
+  const overlapped = source.slice(source.indexOf('$handle_ReadFile'),
+    source.indexOf('$handle_CreateFileW'));
+  assert.ok(overlapped.length > 0, 'the ReadFile handler is present');
+  assert.ok(/call \$gs32\s*\(local\.get \$arg3\)/.test(overlapped),
+    'the OVERLAPPED branch writes the byte count through lpBytesRead, not only InternalHigh');
+  assert.ok(!/even when \$arg3|only InternalHigh/i.test(overlapped.replace(/;;[^\n]*/g, '')),
+    'and it is not documented as deliberately skipping lpBytesRead');
+
+  console.log('PASS parked ReadFile publishes no byte count until the call actually completes');
+}
+
+main().catch(error => { console.error(error); process.exit(1); });
